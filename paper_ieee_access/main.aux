\@writefile{lof}{\contentsline {figure}{\numberline {1}{\ignorespaces Architecture of LLM-Flax\xspace  . \emph  {Top}: Stage~1 generates relaxation and complementary rules once per domain and validates the resulting JSON. \emph  {Bottom}: the Flax planning loop performs threshold-decay pruning, rule-based relaxation, and complementary expansion. Stage~2 optionally inserts a feasibility-gated recovery call after a pruning timeout; Stage~3 substitutes zero-shot LLM scores for the GNN scores. Stage~1 removes manual rule authoring, whereas Stage~3 removes GNN training.}}{3}{figure.caption.1}\protected@file@percent }
\providecommand*\caption@xref[2]{\@setref\relax\@undefined{#1}}
\newlabel{fig:architecture}{{1}{3}{Architecture of \method . \emph {Top}: Stage~1 generates relaxation and complementary rules once per domain and validates the resulting JSON. \emph {Bottom}: the Flax planning loop performs threshold-decay pruning, rule-based relaxation, and complementary expansion. Stage~2 optionally inserts a feasibility-gated recovery call after a pruning timeout; Stage~3 substitutes zero-shot LLM scores for the GNN scores. Stage~1 removes manual rule authoring, whereas Stage~3 removes GNN training}{figure.caption.1}{}}
\newlabel{fig:architecture@cref}{{[figure][1][]1}{[1][2][]3}}
